# RoadWatch HP environment configuration
# Copy to .env and adjust as needed. Never commit .env.

APP_NAME=RoadWatch_HP
ENVIRONMENT=development
DEBUG=true

# Backend service (listens on 8000 inside container, published on host 8002)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Public URL browsers use to reach the backend (host port 8002).
PUBLIC_BACKEND_URL=http://localhost:8002
# Public base URL for uploaded image URLs.
UPLOAD_BASE_URL=http://localhost:8002/uploads
# Maximum upload size in bytes (10 MB).
UPLOAD_MAX_SIZE=10485760

# AI service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
# Internal Docker URL for backend-to-AI-service calls.
AI_SERVICE_URL=http://ai-service:8001

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/roadwatch

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8002
VITE_AI_SERVICE_URL=http://localhost:8001
